      "content": [
        {
          "kind": "text",
          "text": "About Mark",
          "marks": {},
          "link": null
        }
      ]
    },
    {
      "align": "center",
      "kind": "image",
      "image": {
        "url": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:lehcqqkwzcwvjvw66uthu5oq/bafkreifqczfh25syz3yywxr5tbcp4amtwmnqr4lnplmcshkp7w2mdu25wq@jpeg",
        "alt": "",
