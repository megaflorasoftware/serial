    },
    {
      "align": null,
      "kind": "callout",
      "emoji": "🪿",
      "color": "rgb(59 130 246 / 0.2)",
      "tint": "rgb(59 130 246 / 0.2)",
      "content": [
        {
          "kind": "text",
          "text": "The AtmosphereConf website is open source and community maintained, see the source ",
          "marks": {},
          "link": null
        },
        {
          "kind": "text",
          "text": "on Github",
          "marks": {},
          "link": {
            "href": "https://github.com/ATProtocol-Community/atmosphereconf/",
            "record": null
          }
        },
        {
          "kind": "text",
          "text": ". Led by Ms. Boba's ",
          "marks": {},
          "link": null
        },
        {
          "kind": "text",
          "text": "@essentialrandom.bsky.social",
          "marks": {},
          "link": {
            "href": "https://bsky.app/profile/did:plc:r2vpg2iszskbkegoldmqa322",
            "record": null
          }
        },
        {
          "kind": "text",
          "text": "  web mistress work from last year, and many community theming contributions, we'll be adding to it for the 2027 edition, with even more atmospheric features. In the meantime, if you're interested in getting involved in transcript translations, get in touch!",
          "marks": {},
          "link": null
