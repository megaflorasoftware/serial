            {
              "align": null,
              "kind": "paragraph",
              "content": [
                {
                  "kind": "text",
                  "text": "Hyperaudio Lite Editor – transcript editing with local Parakeet transcription, and the engine behind the conference transcripts: ",
                  "marks": {},
