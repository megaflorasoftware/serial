    {
      "align": null,
      "kind": "paragraph",
      "content": [
        {
          "kind": "text",
          "text": "Mark Boas has spent 15 years building interactive-transcript technology through The Hyperaudio Project. He co-created jPlayer (a JS-based media library back in the day), cofounded Trint, consulted for BBC News Labs, and was a Knight-Mozilla OpenNews Fellow at Al Jazeera, where he returned to build Palestine Remix. Until May 2026 he was CTO of oral history platform TheirStory. He’s now an independent consultant, helping organisations make their audio and video content usable through transcription, translation and discovery – working on The Hyperaudio Project with Bad Idea Factory, focussed on open source, decentralised systems and the judicious application of AI. Find him at ",
          "marks": {},
          "link": null
        },
        {
          "kind": "text",
          "text": "maboa.it",
          "marks": {},
          "link": {
            "href": "https://maboa.it/",
            "record": null
          }
        },
        {
          "kind": "text",
          "text": " and ",
          "marks": {},
          "link": null
        },
        {
          "kind": "text",
          "text": "@maboa.bsky.social",
          "marks": {},
          "link": {
            "href": "https://discourse.atmosphere.community/u/maboa.bsky.social",
            "record": null
          }
        },
        {
          "kind": "text",
          "text": ".",
          "marks": {},
          "link": null
        }
      ]
