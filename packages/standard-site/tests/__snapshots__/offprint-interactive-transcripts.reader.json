                  "marks": {},
                  "link": null
                },
                {
                  "kind": "text",
                  "text": "https://github.com/hyperaudio/hyperaudio-lite",
                  "marks": {},
                  "link": {
                    "href": "https://github.com/hyperaudio/hyperaudio-lite",
                    "record": null
                  }
                }
              ]
            }
          ],
          "checked": null
