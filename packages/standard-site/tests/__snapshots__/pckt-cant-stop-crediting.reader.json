    {
      "align": "center",
      "kind": "image",
      "image": {
        "url": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:x5leeami62gbmjekf7ro6sqo/bafkreiepdk3z4quxkamblmv4jqvapbeojhmwxzwsnsyrpfiau7fkzcrszy@jpeg",
        "alt": "closing scene of the \"can't stop\" video that has a sign that says \"INSPIRED BY THE 'ONE-MINUTE SCULPTURES' OF ERWIN WURM\"",
        "title": null,
        "aspectRatio": {
          "width": 1578,
          "height": 1180
        },
        "width": {
          "value": 500,
          "unit": "px"
        },
