    {
      "align": null,
      "kind": "paragraph",
      "content": [
        {
          "kind": "text",
          "text": "When posting as your blog, your most recent note will display at the top of your blog's home page, and a notes page will be available to show all of the notes for your blog. ",
          "marks": {},
          "link": null
        }
      ]
    },
    {
      "align": null,
      "kind": "paragraph",
      "content": [
        {
          "kind": "text",
          "text": "Personal notes skip the blog and go straight to the community feed, making it easy to start conversations. ",
          "marks": {},
          "link": null
        }
      ]
    },
