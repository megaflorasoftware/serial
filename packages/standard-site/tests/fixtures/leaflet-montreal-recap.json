            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [],
                "plaintext": "The ATProto community gathered in Montreal in the first week of November 2025. IETF124 and the AT Protocol pre-BOF is the reason for gathering together, and we also took the opportunity for a couple of community days."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.website",
                "description": "Register today for the IETF 124 Montreal meeting on 1-7 November 2025 with 1000+ participants and 100+ sessions, including an IETF Hackathon.",
                "previewImage": {
                  "$type": "blob",
                  "mimeType": "image/png",
                  "ref": {
                    "$link": "bafkreibftn5kyxviu44fwhho3gnct5x2yzmfojloa2yeuutmnburpbqhfy"
                  },
                  "size": 42377
                },
                "src": "https://www.ietf.org/meeting/124/",
                "title": "IETF 124 Montreal"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "features": [
                      {
                        "$type": "pub.leaflet.richtext.facet#link",
                        "uri": "https://discourse.atprotocol.community/t/atproto-community-sessions-in-montreal-for-ietf124/164"
                      }
                    ],
                    "index": {
                      "byteEnd": 34,
                      "byteStart": 9
                    }
                  }
                ],
                "plaintext": "We had a rough agenda in the forum that we mostly stuck to, as well as some nice meals and lots of talking to other ATProto builders."
              }
            },
