            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "From the Reader feeds, you can open posts, hit recommend, and copy the share link directly. You can also click the comments and mentions buttons to preview the social context before reading."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "index": {
