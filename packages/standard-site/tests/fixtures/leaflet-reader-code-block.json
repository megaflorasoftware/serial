                    },
                    "features": [
                      {
                        "$type": "pub.leaflet.richtext.facet#italic"
                      }
                    ]
                  }
                ],
                "plaintext": "Sidebar: the Trending feed"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "index": {
                      "byteEnd": 21,
                      "byteStart": 13
                    },
                    "features": [
                      {
                        "$type": "pub.leaflet.richtext.facet#bold"
                      },
                      {
                        "$type": "pub.leaflet.richtext.facet#italic"
                      }
                    ]
                  },
                  {
                    "index": {
                      "byteEnd": 85,
                      "byteStart": 73
                    },
                    "features": [
                      {
                        "uri": "https://www.righto.com/2013/11/how-hacker-news-ranking-really-works.html",
                        "$type": "pub.leaflet.richtext.facet#link"
                      }
                    ]
                  }
                ],
                "plaintext": "How does the Trending algo work? It's basically the Hacker News homepage ranking algo, lightly tweaked. We calculate a score for recent posts, based on both Bluesky likes and Leaflet recommendations (the latter weighted more strongly)."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "Right now we show the top 50 recent posts. The score decays rapidly, within hours, so we could play with that variable so posts stick around a bit longer."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.code",
                "plaintext": "SELECT uri\nFROM documents\nWHERE indexed = true\nAND sort_date > now() - interval '7 days'\nORDER BY\n(bsky_like_count + recommend_count * 5)::numeric \n/ power(extract(epoch from (now() - sort_date)) / 3600 + 2, 1.5) DESC\nLIMIT 50"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "⁂ ⁂ ⁂"
              },
              "alignment": "lex:pub.leaflet.pages.linearDocument#textAlignCenter"
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.header",
                "level": 2,
                "plaintext": "Future ideas for Reader"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "One thing that'd be really cool to build on this: custom feeds."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "We'd love to show more things in Reader feeds too, e.g. more context-rich recommendations, or surfacing things your friends are reading."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "And we'd like to have some nicer way to navigate between posts as you read, maybe an iframe wrapper, with footer for interactions and navigation / browsing."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "index": {
                      "byteEnd": 62,
                      "byteStart": 49
                    },
                    "features": [
                      {
                        "uri": "https://standard.site",
                        "$type": "pub.leaflet.richtext.facet#link"
                      }
                    ]
                  }
                ],
                "plaintext": "Since we can show not only Leaflet posts but any standard.site compatible posts, it'd be nice to support more standard social interactions (like comments) on all posts in some form, too."
              }
            }
          ]
