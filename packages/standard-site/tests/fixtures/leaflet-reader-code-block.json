            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "We merged our old Reader (showing your subscriptions) and our previous Discover page into a new \"Reader\" with multiple feeds:"
              }
            },
