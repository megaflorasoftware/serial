          "blocks": [
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "We shipped post recommendations, and improved Leaflet Reader. We also reworked overall Leaflet nav, with clearer \"Read\" and \"Write\" modes. Here's what's new!"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.header",
                "level": 2,
                "plaintext": "Recommend posts"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "You can hit the \"recommend\" button (heart icon) from the top or bottom of a post, to show your appreciation."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "index": {
                      "byteEnd": 21,
                      "byteStart": 17
                    },
                    "features": [
                      {
                        "$type": "pub.leaflet.richtext.facet#italic"
                      }
                    ]
                  }
                ],
                "plaintext": "Yes, basically a like button, but…for recommending!"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "plaintext": "Publishers can turn off recommendations for a publication, or per-post if you like."
              }
            },
