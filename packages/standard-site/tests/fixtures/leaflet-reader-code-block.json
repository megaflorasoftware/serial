                      "plaintext": "Subs: posts from your subscribed publications"
                    }
                  },
                  {
                    "$type": "pub.leaflet.blocks.unorderedList#listItem",
                    "content": {
                      "$type": "pub.leaflet.blocks.text",
                      "plaintext": "Trending: hottest recent posts"
                    }
                  },
                  {
                    "$type": "pub.leaflet.blocks.unorderedList#listItem",
                    "content": {
                      "$type": "pub.leaflet.blocks.text",
