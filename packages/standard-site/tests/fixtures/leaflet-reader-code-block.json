            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "alt": "leaflet reader, with \"what's hot\" (since renamed \"trending\") feed shown, with post list + comments for one of the visible posts, \"Announcing Skyboard\", open in sidebar",
                "$type": "pub.leaflet.blocks.image",
                "image": {
                  "ref": {
                    "$link": "bafkreibbhedxkn64kiorp77z5lt6wabivnw34misxus2yttfmsspym6dvq"
