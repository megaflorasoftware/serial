            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [],
                "plaintext": "We rebuilt this from our earlier polls block in standalone documents. It's now fully atproto-ified, and works a little differently, e.g. you can't edit a poll after it's been published."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [],
                "plaintext": "Right now published polls are also limited to a single response. We'd like to add some options, like a way to give a poll a limited duration, or allow multiple responses."
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [],
                "plaintext": "Pretty soon we'll make it possible to publish standalone docs to atproto as well, which will make it easier to do quick one-off polls for anything!"
              }
            },
            {
              "$type": "pub.leaflet.pages.linearDocument#block",
              "block": {
                "$type": "pub.leaflet.blocks.text",
                "facets": [
                  {
                    "index": {
                      "byteEnd": 34,
                      "byteStart": 18
                    },
                    "features": [
                      {
                        "$type": "pub.leaflet.richtext.facet#code"
                      }
                    ]
                  }
                ],
                "plaintext": "The lexicon is at pub.leaflet.poll — we decided to stick to something scoped under the pub.leaflet namespace for simplicity, but polls definitely could be a shared lexicon that different apps use. We hope that others experiment with them, both with their own lexicons and building off the records we're publishing. One of the cool things about ATProto is that we can coordinate gradually over time, and all the data is still out there, in a simple format, for us to build on!"
              }
            }
          ]
