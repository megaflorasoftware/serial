{
  "name": "serial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@serial/app",
    "dev:demo": "node apps/extension/scripts/dev-demo.mjs",
    "dev:demo:chrome": "node apps/extension/scripts/dev-demo.mjs chrome",
    "dev:demo:firefox": "node apps/extension/scripts/dev-demo.mjs firefox",
    "test:prototype:capture:firefox": "pnpm --filter @serial/extension test:prototype:capture:firefox",
    "dev:extension": "pnpm --filter @serial/extension dev",
    "build": "turbo run build:artifact",
    "build:artifact": "turbo run build:artifact",
    "build:atomic": "pnpm --filter @serial/app build:atomic",
    "build:sw": "pnpm --filter @serial/app build:sw",
    "schema:generate": "pnpm --filter @serial/app schema:generate",
    "schema:migrate": "pnpm --filter @serial/app schema:migrate",
    "schema:update": "pnpm --filter @serial/app schema:update",
    "start": "pnpm schema:migrate && pnpm --filter @serial/app start",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --recursive --if-present lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "pnpm --recursive --if-present format",
    "format:fix": "pnpm --recursive --if-present format:fix",
    "precommit": "pnpm typecheck && pnpm lint:fix && pnpm format:fix",
    "precommit:fast": "pnpm format:fix",
    "test": "pnpm --filter @serial/app test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "pnpm --filter @serial/app test:e2e",
    "test:e2e:main": "pnpm --filter @serial/app test:e2e:main",
    "test:e2e:ownership": "pnpm --filter @serial/app test:e2e:ownership",
    "test:e2e:self-hosted": "pnpm --filter @serial/app test:e2e:self-hosted",
    "test:e2e:self-hosted-bootstrap": "pnpm --filter @serial/app test:e2e:self-hosted-bootstrap",
    "test:e2e:demo": "pnpm --filter @serial/app test:e2e:demo"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1",
    "turbo": "2.10.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.8.0",
  "simple-git-hooks": {
    "pre-commit": "if git diff --cached --name-only | grep -qE '\\.(js|ts|tsx|jsx)$'; then pnpm precommit; else pnpm precommit:fast; fi"
  }
}
