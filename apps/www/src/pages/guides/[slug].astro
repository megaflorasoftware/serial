---
import { render } from "astro:content";
import dayjs from "dayjs";
import FooterCTA from "../../components/FooterCTA.astro";
import Icon from "../../components/Icon.astro";
import Site from "../../layouts/Site.astro";
import { getAllGuides } from "../../lib/content";

export async function getStaticPaths() {
  const guides = await getAllGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const GUIDE_ICONS: Record<string, string> = {
  youtube: "youtube",
  rss: "rss",
  "book-open": "book-open",
  "pen-line": "pen-line",
};

const { guide } = Astro.props;
const { Content } = await render(guide);

const iconName = guide.data.icon ? GUIDE_ICONS[guide.data.icon] : undefined;
const description =
  guide.data.description ?? `Guide for ${guide.data.title}`;
---

<Site
  title={`${guide.data.title} | Serial`}
  description={description}
  ogImage={`/og/guides/${guide.id}.png`}
  ogType="article"
  publishDate={guide.data.publish_date}
>
  <div class="pt-8 pb-12 md:pt-12 md:pb-24">
    <article class="mx-auto max-w-3xl px-6 text-xl text-pretty">
      <div class="mx-auto mt-20 mb-12 max-w-2xl text-center text-balance">
        {
          iconName && (
            <div class="bg-muted mb-6 inline-flex items-center justify-center rounded-xl p-4">
              <Icon name={iconName} size={32} class="text-muted-foreground" />
            </div>
          )
        }
        <h1 class="text-3xl leading-tight font-bold md:text-4xl">
          {guide.data.title}
        </h1>
        {
          guide.data.description && (
            <p class="mt-3 text-lg">{guide.data.description}</p>
          )
        }
        <p class="text-muted-foreground mt-2 text-lg">
          {dayjs(guide.data.publish_date).format("MMMM DD, YYYY")}
          {
            guide.data.updated_at && (
              <span class="ml-2">
                ·
                <span class="ml-2">
                  Updated {dayjs(guide.data.updated_at).format("MMMM DD, YYYY")}
                </span>
              </span>
            )
          }
        </p>
      </div>
      <div class="guides article-flow">
        <Content />
      </div>
    </article>
    <div class="mt-12 lg:mt-16"></div>
    <FooterCTA />
  </div>
</Site>
