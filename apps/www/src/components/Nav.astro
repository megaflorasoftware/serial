---
import { GITHUB_URL } from "../lib/site";
import AppLink from "./AppLink.astro";
import Icon from "./Icon.astro";
---

<header class="border-muted mx-auto max-w-4xl px-4 pt-4 lg:px-0 lg:pt-8">
    <nav class="flex items-center gap-0 sm:gap-1">
        <div class="flex flex-1 justify-start">
            <a
                href="/"
                class="hover:bg-muted flex items-center justify-center gap-0 rounded px-2 py-1 text-xl font-bold transition-all sm:gap-2"
            >
                <img
                    src="/favicon-32x32.png"
                    class="mx-auto size-5 shrink-0 rounded"
                    alt="Serial logo"
                />
                <span class="hidden sm:inline">Serial</span>
            </a>
        </div>
        <div class="flex flex-none items-center gap-0 sm:gap-1">
            <a
                href="/downloads"
                class="text-md text-muted-foreground hover:bg-muted block rounded px-2 py-1 font-semibold transition-all"
            >
                Downloads
            </a>
            <a
                href="/releases"
                class="text-md text-muted-foreground hover:bg-muted block rounded px-2 py-1 font-semibold transition-all"
            >
                Releases
            </a>
            <a
                href="/guides"
                class="text-md text-muted-foreground hover:bg-muted block rounded px-2 py-1 font-semibold transition-all"
            >
                Guides
            </a>
            <a
                href="/pricing"
                class="text-md text-muted-foreground hover:bg-muted block rounded px-2 py-1 font-semibold transition-all"
            >
                Pricing
            </a>
        </div>
        <div class="hidden flex-1 items-center justify-end gap-2 md:flex">
            <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline gap-1.5"
            >
                <Icon name="star" size={16} /> Star
            </a>
            <AppLink />
        </div>
    </nav>
</header>
