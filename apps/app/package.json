{
  "name": "@serial/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:db": "turso dev --db-file serial.db",
    "dev:db:test:main": "turso dev --db-file serial-test-main-instance.db --port ${SERIAL_TEST_MAIN_TURSO_PORT:-8081}",
    "dev:db:test:self-hosted": "turso dev --db-file serial-test-self-hosted.db --port ${SERIAL_TEST_SELF_HOSTED_TURSO_PORT:-8082}",
    "dev:db:test:demo": "turso dev --db-file serial-test-demo.db --port ${SERIAL_TEST_DEMO_TURSO_PORT:-8083}",
    "dev:db:demo": "turso dev --db-file serial-demo.db",
    "dev:migrate:test:main": "dotenv -e .env.test.main -- pnpm schema:migrate",
    "dev:migrate:test:self-hosted": "dotenv -e .env.test.self-hosted -- pnpm schema:migrate",
    "dev:migrate:test:demo": "dotenv -e .env.test.demo -- pnpm schema:migrate",
    "dev:test:main": "concurrently --kill-others \"pnpm dev:db:test:main\" \"pnpm dev:migrate:test:main && dotenv -e .env.test.main -- vite dev --port ${SERIAL_TEST_MAIN_APP_PORT:-3002} --strictPort\"",
    "dev:test:self-hosted": "concurrently --kill-others \"pnpm dev:db:test:self-hosted\" \"pnpm dev:migrate:test:self-hosted && dotenv -e .env.test.self-hosted -- vite dev --port ${SERIAL_TEST_SELF_HOSTED_APP_PORT:-3001} --strictPort\"",
    "dev:test:demo": "concurrently --kill-others \"pnpm dev:db:test:demo\" \"pnpm dev:migrate:test:demo && dotenv -e .env.test.demo -- vite dev --mode demo --host --port ${SERIAL_TEST_DEMO_APP_PORT:-3005} --strictPort\"",
    "dev:migrate": "pnpm schema:migrate",
    "dev:atomic": "NODE_OPTIONS='--import ./instrument.server.mjs' dotenv -e .env.local -- vite dev",
    "dev:polar": "polar listen http://localhost:3000/api/auth/polar/webhooks",
    "dev": "concurrently --kill-others \"pnpm dev:db\" \"pnpm dev:migrate && pnpm dev:atomic\"",
    "dev:demo": "node scripts/dev-demo.mjs",
    "dev:email": "email dev --dir ./src/emails --port 4000",
    "prebuild": "pnpm typecheck && pnpm format && pnpm lint",
    "build:sw": "node --import=tsx ./scripts/generate-sw.ts",
    "build:atomic": "vite build && cp instrument.server.mjs .output/server && pnpm build:sw",
    "build:artifact": "pnpm build:atomic",
    "build": "pnpm build:atomic && pnpm schema:migrate",
    "build:local": "concurrently --kill-others \"pnpm dev:db\" \"pnpm build\"",
    "schema:generate": "SKIP_ENV_VALIDATION=true drizzle-kit generate",
    "schema:migrate": "node --import tsx src/server/db/migrate.ts",
    "schema:update": "pnpm schema:generate && pnpm schema:migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:test:main": "dotenv -e .env.test.main -- drizzle-kit studio",
    "db:studio:test:self-hosted": "dotenv -e .env.test.self-hosted -- drizzle-kit studio",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "start:local": "concurrently --kill-others \"pnpm dev:db\" \"dotenv -e .env.local -- pnpm start\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "precommit": "pnpm typecheck && pnpm lint:fix && pnpm format:fix",
    "precommit:fast": "pnpm format:fix",
    "test": "concurrently \"pnpm test:unit\" \"pnpm test:e2e:main\" \"pnpm test:e2e:self-hosted\" \"pnpm test:e2e:demo\"",
    "test:unit": "vitest run",
    "test:e2e": "concurrently \"pnpm test:e2e:main\" \"pnpm test:e2e:self-hosted\" \"pnpm test:e2e:demo\"",
    "test:e2e:main": "node --import=tsx scripts/run-e2e.ts main",
    "test:e2e:ownership": "BACKGROUND_REFRESH_ENABLED=true SERIAL_EXPECT_AUTOMATIC_RSS_OWNER=background-task node --import=tsx scripts/run-e2e.ts main reconciliation-ownership.spec.ts && BACKGROUND_REFRESH_ENABLED=false SERIAL_EXPECT_AUTOMATIC_RSS_OWNER=client node --import=tsx scripts/run-e2e.ts main reconciliation-ownership.spec.ts && BACKGROUND_REFRESH_ENABLED=true SERIAL_EXPECT_AUTOMATIC_RSS_OWNER=background-task node --import=tsx scripts/run-e2e.ts self-hosted reconciliation-topology.spec.ts && BACKGROUND_REFRESH_ENABLED=false SERIAL_EXPECT_AUTOMATIC_RSS_OWNER=client node --import=tsx scripts/run-e2e.ts self-hosted reconciliation-topology.spec.ts",
    "test:e2e:main:ui": "node --import=tsx scripts/run-e2e.ts main --ui",
    "test:e2e:headed": "node --import=tsx scripts/run-e2e.ts main --headed",
    "test:e2e:self-hosted": "SERIAL_CLIENT_PERFORMANCE_PRODUCTION=1 node --import=tsx scripts/run-e2e.ts self-hosted",
    "test:e2e:self-hosted-bootstrap": "SERIAL_CLIENT_PERFORMANCE_PRODUCTION=1 node --import=tsx scripts/run-e2e.ts self-hosted --project self-hosted-bootstrap",
    "test:e2e:self-hosted-config": "SERIAL_CLIENT_PERFORMANCE_PRODUCTION=1 node --import=tsx scripts/run-e2e.ts self-hosted --project self-hosted-config",
    "test:e2e:self-hosted-unconfigured": "SERIAL_CLIENT_PERFORMANCE_PRODUCTION=1 node --import=tsx scripts/run-e2e.ts self-hosted --project self-hosted-unconfigured",
    "test:e2e:self-hosted:dev": "node --import=tsx scripts/run-e2e.ts self-hosted",
    "test:e2e:self-hosted:ui": "node --import=tsx scripts/run-e2e.ts self-hosted --ui",
    "test:e2e:cleanup": "node --import=tsx scripts/test-e2e-cleanup.ts",
    "test:e2e:demo": "node --import=tsx scripts/run-e2e.ts demo",
    "test:e2e:demo:ui": "node --import=tsx scripts/run-e2e.ts demo --ui",
    "benchmark:app": "node --expose-gc --import=tsx scripts/performance/run-app-benchmark.ts",
    "benchmark:app:smoke": "node --expose-gc --import=tsx scripts/performance/run-app-benchmark.ts --profile small --cache warm --output benchmarks/results/local-small.json",
    "benchmark:app:gate": "node --expose-gc --import=tsx scripts/performance/run-app-benchmark.ts --profile representative --cache all --gate",
    "benchmark:navigation": "node --expose-gc --import=tsx scripts/performance/run-navigation-benchmark.ts",
    "benchmark:view-matrix:gate": "dotenv -e .env.test -- node --expose-gc --import=tsx scripts/performance/run-view-matrix-benchmark.ts --gate --output benchmarks/results/view-matrix-gate.json",
    "benchmark:client": "dotenv -e .env.test -- node --import=tsx scripts/performance/run-client-audit.ts",
    "benchmark:client:smoke": "dotenv -e .env.test -- node --import=tsx scripts/performance/run-client-audit.ts --profile small --output benchmarks/results/client-small.json",
    "benchmark:client:gate": "pnpm benchmark:client --profile small --gate && pnpm benchmark:client --profile representative --gate && pnpm benchmark:client --profile stress --gate",
    "benchmark:client:coverage": "node --import=tsx scripts/performance/inventory-client-audit.ts",
    "benchmark:client:coverage:check": "node --import=tsx scripts/performance/inventory-client-audit.ts --check",
    "benchmark:inventory": "node --import=tsx scripts/performance/inventory-app-queries.ts",
    "benchmark:inventory:check": "node --import=tsx scripts/performance/inventory-app-queries.ts --check"
  },
