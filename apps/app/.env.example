# PUBLIC_* values are sent to the browser. Never store secrets in them.
# REQUIRED - Public origin of this instance (e.g. https://www.example.com).
PUBLIC_BASE_URL=

# REQUIRED - Authentication
# Generate a secret here: https://www.better-auth.com/docs/installation#set-environment-variables
# Alternatively, run `openssl rand -base64 32` in a terminal and use that value.
BETTER_AUTH_SECRET=

# Database (only for cloud dbs or local libsql running on a custom port)
# DATABASE_URL='http://127.0.0.1:8080'
# DATABASE_AUTH_TOKEN=

# OAuth (optional, for custom SSO login)
# OAUTH_PROVIDER_ID=
# OAUTH_PROVIDER_NAME=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_DISCOVERY_URL=
# OAUTH_AUTHORIZATION_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USER_INFO_URL=
# OAUTH_SCOPES=
# OAUTH_PKCE=false
# OAUTH_REDIRECT_URI=

# AT Protocol / Atmosphere sign-in (optional). Set both or neither — a
# partial pair fails startup.
# ATPROTO_CLIENT_PRIVATE_KEYS is a JSON array of ES256 private JWKs; the
# first key signs, the rest stay published for rotation. Generate one with:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(async k=>console.log(JSON.stringify([{kid:crypto.randomUUID(),...await crypto.subtle.exportKey('jwk',k.privateKey)}])))"
# ATPROTO_STORE_ENCRYPTION_KEY encrypts stored OAuth sessions at rest.
# Generate with: openssl rand -base64 32
# Atmosphere sign-in also requires an https PUBLIC_BASE_URL (authorization
# servers must fetch the client metadata it publishes). With the keys set
# but a non-viable base URL, Atmosphere is disabled with a startup warning.
# Exception for local development: a plain-http loopback base URL
# (http://localhost:3000, http://127.0.0.1:3000) runs a public RFC 8252
# loopback client instead, so the full round trip is testable locally —
# browse the app on http://127.0.0.1 when QAing it.
# ATPROTO_CLIENT_PRIVATE_KEYS=
# ATPROTO_STORE_ENCRYPTION_KEY=
# Override the PLC directory only when testing against a local dev network.
# ATPROTO_PLC_DIRECTORY_URL=
# AppView backing the sign-in handle typeahead. Defaults to the public
# Bluesky AppView; point it at any host serving searchActorsTypeahead.
# In production this must be an https, publicly routable host (the proxy's
# SSRF-hardened fetch rejects http and private addresses).
# ATPROTO_APPVIEW_URL=https://public.api.bsky.app

# Serial extension (optional, comma-separated additional identity redirect URIs)
# The official Chrome and Firefox extension redirects are enabled automatically.
# If a browser store assigns a different identity, add the redirect returned by
# browser.identity.getRedirectURL() here before connecting that extension build.
# SERIAL_EXTENSION_REDIRECT_URIS=

# Trusted Origins (optional, comma-separated list of additional origins)
# Use this when the app is accessed through a masked redirect or reverse proxy
# and you need auth, including extension sign-in, to use that public alias.
# TRUSTED_ORIGINS=

# Email (optional — needed for password reset and email verification)
# FROM_EMAIL_ADDRESS is required for email sending to work.
# If both provider keys are set, Resend takes priority.
FROM_EMAIL_ADDRESS=
PUBLIC_SUPPORT_EMAIL_ADDRESS=

RESEND_API_KEY=
SENDGRID_API_KEY=

# Integrations
INSTAPAPER_OAUTH_ID=
INSTAPAPER_OAUTH_SECRET=

# Key-Value Store (optional — enables durable real-time sync)
# Options: "none" (default), "ioredis" (local Redis), "upstash" (Upstash Redis)
# For Docker self-hosted: automatically set to "ioredis" via docker-compose
# For standalone: set to "upstash" and configure UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# KV_STORE=none
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Analytics (optional; set both values to enable Umami)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Error Tracking (Sentry/GlitchTip)
PUBLIC_SENTRY_DSN_WEB=
SENTRY_DSN_BACKEND=

# Misc
# If true, prevents users from accessing the instance. Useful for database or infrastructure updates.
PUBLIC_IS_MAINTENANCE_MODE=
